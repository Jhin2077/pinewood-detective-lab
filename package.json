{
  "name": "pinewood-case-lab-online-workshop",
  "version": "0.1.0",
  "description": "Pinewood Detective Lab 的在线案件板社区与 Workshop 交互预览。",
  "author": "JHIN",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "ui:export-icons": "node scripts/export-ui-icons.mjs",
    "ui:build-semiotic": "node scripts/build-semiotic-library.mjs",
    "ui:package-semiotic": "npm run ui:build-semiotic && pwsh -NoLogo -NoProfile -File scripts/package-semiotic-library.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@fontsource/wire-one": "^5.3.0",
    "ogl": "^1.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.0"
  }
}
